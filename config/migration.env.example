# Copy to migration.env and fill in, or just run scripts/00-prereqs.sh which
# writes this file interactively. Never commit the real migration.env.
#
# No password lives here. icloudpd prompts for the password and 2FA code
# interactively and caches a session cookie under TARGET_ROOT/.icloudpd-cache.

APPLE_ID="you@example.com"
TARGET_ROOT="/Volumes/YOUR_DRIVE/iCloud_Import"
CREATOR="Your Name"
CREATOR_LOCATION="City, Country"
CREATOR_COUNTRY_CODE="AUS"
RIGHTS_URL=""
KEEP_LIVE_PHOTO_MOVS=1

# Write copyright INTO HEIC/JPEG/PNG/TIFF/DNG originals. Leave at 0.
# Embedding changes file sizes, and icloudpd then re-downloads every changed
# file on the next extract or delta run. Use an LRC import preset instead.
EMBED_METADATA=0

# Set to 1 to use icloudpd --adp-web-access instead of turning off Advanced
# Data Protection. Needs icloudpd 1.33+ and approval on an Apple device.
ADP_WEB_ACCESS=0

# Free space Phase 0 insists on. 1100 suits the full ~850 GB library.
# Lower it (for example 20) for a sample run on a test target.
MIN_FREE_GB=1100
