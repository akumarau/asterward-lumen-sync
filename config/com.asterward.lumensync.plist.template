<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Asterward Lumen Sync, monthly delta sync job. Template.
  Install with:   bin/lumen-sync install-schedule
  That fills in your paths, lints the plist, and loads it with launchctl.

  The generated file is gitignored because it contains absolute home paths.
  If the older com.icloudsync job is installed, remove it first:
    launchctl bootout gui/$(id -u)/com.icloudsync
    rm ~/Library/LaunchAgents/com.icloudsync.plist

  macOS privacy: the first run writes to an external volume, so macOS may ask
  to allow /bin/bash access to Removable Volumes. launchd cannot answer that
  prompt. Run `bin/lumen-sync delta` once from Terminal to grant it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asterward.lumensync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/99-delta-sync.sh</string>
    </array>

    <!-- APPLE_ID and CREATOR come from config/migration.env, which the script sources. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>TARGET_ROOT</key>
        <string>__TARGET_ROOT__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Run monthly at 02:00 local time on the 1st -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__TARGET_ROOT__/logs/lumensync-launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__TARGET_ROOT__/logs/lumensync-launchd-stderr.log</string>

    <!-- launchd has no drive-presence key. 99-delta-sync.sh calls require_mount
         and exits non-zero if the target volume is not attached. -->
</dict>
</plist>
